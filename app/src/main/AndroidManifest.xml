<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Restores a session that was running when the device restarted: a reboot ends the process, and
      START_STICKY does not survive one. BOOT_COMPLETED is also one of the few contexts permitted to
      start a foreground service from the background, which is what makes the restore possible.

      Note there is deliberately no SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM here: every alarm the app
      sets is inexact, for the reasons set out on SessionAlarms.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CheckInApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CheckInApp.Starting">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CheckInService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-initiated check-in session: shows the ongoing timer notification for the session the user started, active only while the user is checked in. The periodic session reminder and the automatic close at midnight are scheduled separately and do not keep this service running." />
        </service>

        <!-- Records a notification the user swiped away. Internal only: nothing outside the app has
             any reason to report a dismissal, and an exported receiver could forge one. -->
        <receiver
            android:name=".notify.NotificationDismissReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Fires an open session's periodic reminder and its day-boundary close. Internal only: the
             actions are app-private and an exported receiver would let anything on the device close
             a user's session. It handles both itself rather than waking the service, because the
             alarms' whole purpose is to work when the service is gone — and starting one from the
             background would be refused. -->
        <receiver
            android:name=".service.SessionAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.checkin.app.SESSION_REMINDER_DUE" />
                <action android:name="com.checkin.app.SESSION_DAY_BOUNDARY" />
            </intent-filter>
        </receiver>

        <!-- The daily check-in nudge. Its own receiver rather than a third action on the session one:
             the engagement layer is structurally isolated from service/, and this alarm has no
             session to reason about. Not exported — the alarm is the app's own PendingIntent, so
             nothing outside the app has cause to deliver this action. -->
        <receiver
            android:name=".notify.engagement.NudgeAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.checkin.app.NUDGE_CHECKPOINT_DUE" />
            </intent-filter>
        </receiver>

        <!-- Restores a session left open across a reboot or an app update. Both end the process and
             clear the session's alarms, and both are permitted to start a foreground service from
             the background. Exported is required for the system to deliver either broadcast; the
             receiver ignores every other action. -->
        <receiver
            android:name=".service.SessionRestoreReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
