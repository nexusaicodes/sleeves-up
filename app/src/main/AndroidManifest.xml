<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Restores a session that was running when the device restarted: a reboot ends the process, and
      START_STICKY does not survive one. BOOT_COMPLETED is also one of the few contexts permitted to
      start a foreground service from the background, which is what makes the restore possible.

      Note there is deliberately no SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM here: every alarm the app
      sets is inexact, for the reasons set out on SessionAlarms.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Declared required="false" so a device without a camera — a ChromeOS machine, a display-less
      tablet — can still install and use the app. History, Reports and the About screen need no
      camera at all, and the presence gate treats a camera it cannot run a check on as the state
      that offers device unlock, so the check-in path degrades rather than disappearing. Omitting
      these entirely is what CAMERA alone implies: Play would infer required="true" and filter the
      app off exactly those devices.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <application
        android:name=".CheckInApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CheckInApp.Starting">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CheckInService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-initiated check-in session: shows the ongoing timer notification for the session the user started, active only while the user is checked in. The periodic session reminder and the automatic close at midnight are scheduled separately and do not keep this service running." />
        </service>

        <!-- Fires an open session's periodic reminder and its day-boundary close. Internal only: the
             actions are app-private and an exported receiver would let anything on the device close
             a user's session. It handles both itself rather than waking the service, because the
             alarms' whole purpose is to work when the service is gone — and starting one from the
             background would be refused. -->
        <receiver
            android:name=".service.SessionAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.checkin.app.SESSION_REMINDER_DUE" />
                <action android:name="com.checkin.app.SESSION_DAY_BOUNDARY" />
            </intent-filter>
        </receiver>

        <!-- The daily check-in nudge. Its own receiver rather than a third action on the session one:
             notify/nudge/ is structurally isolated from service/, and this alarm has no
             session to reason about. Not exported — the alarm is the app's own PendingIntent, so
             nothing outside the app has cause to deliver this action. -->
        <receiver
            android:name=".notify.nudge.NudgeAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.checkin.app.NUDGE_CHECKPOINT_DUE" />
            </intent-filter>
        </receiver>

        <!-- Restores a session left open across a reboot or an app update. Both end the process and
             clear the session's alarms, and both are permitted to start a foreground service from
             the background. Exported is required for the system to deliver either broadcast; the
             receiver ignores every other action. -->
        <receiver
            android:name=".service.SessionRestoreReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widget. Exported because the system delivers APPWIDGET_UPDATE to it; all
             an update can do is redraw the widget from the database. Its tap is an explicit intent to
             MainActivity, never a deep link, so nothing else can open the gate through it. The class
             path is frozen: a placed widget names it, and a move takes it off every home screen. -->
        <receiver
            android:name=".widget.CheckInWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/check_in_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Compose brings emoji2, whose startup initializer asks Play services' font provider for an
             emoji font on every launch: a second outside question the Privacy screen does not name.
             Removed, Compose draws emoji with the system font. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <!-- Spark brings FileKit, whose initializer hands it the application context at every
                 launch for its file pickers. The app opens no picker through FileKit. -->
            <meta-data
                android:name="io.github.vinceglb.filekit.initializer.FileKitInitializer"
                tools:node="remove" />
        </provider>

        <!-- FileKit's provider, which shares files its pickers and camera capture create. Another
             app reaches it through a granted URI; the app shares its CSV through its own
             FileProvider above and never through FileKit. -->
        <provider
            android:name="io.github.vinceglb.filekit.dialogs.fileprovider.FileKitFileProvider"
            android:authorities="${applicationId}.FileKitFileProvider"
            tools:node="remove" />

        <!-- Compose Resources' provider, which captures the application context at launch so a
             Res.* read can find its files. Spark's Android code reads its fonts and icons through R,
             and the app makes no Res.* read, since one throws without this provider. Lint reports
             the class missing although Compose Resources carries it, hence the MissingClass ignore. -->
        <provider
            android:name="org.jetbrains.compose.resources.AndroidContextProvider"
            android:authorities="${applicationId}.resources.AndroidContextProvider"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- FileKit's request that Play services install the photo picker backport
             (photopicker_activity) on the device. The app opens no photo picker. The entry is a
             declaration Play services reads, with no class in any library, hence the MissingClass
             ignore. -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            tools:ignore="MissingClass"
            tools:node="remove" />

    </application>

</manifest>
