<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's own backup carries. Everything not excluded here travels: the record (`_app`, with
  its `-wal` and `-shm`, so a restore lands a consistent set and SQLite replays the WAL on open),
  each habit's reminder time (`reminder_prefs`, keyed by the habit uuids `_app` holds), and the nudge
  ledger (`nudges.db`, keyed the same way), and the open session's check-in zone
  (`session_zone_prefs`, keyed by its row id). The record, its habits and everything keyed on them
  restore together, so nothing arrives naming a habit or session that is not there.

  The app itself sends nothing: it holds no network permission. The backup is Android's, to the
  user's own Google account, only when they have backup on, and end-to-end encrypted with the screen
  lock where one is set. `android:restoreAnyVersion` is left at its default (false), so a backup from
  a newer version code is never restored onto an older build, and a restored `_app` is never newer
  than the schema this build opens; an older one runs `MIGRATION_1_2` on first open.

  `ShippedBackupRulesTest` pins this policy.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          `checkin_timer_prefs` mirrors a live session for rendering and holds that session's armed
          alarm instants and reminder count. None of it is true on another device: no alarm is set
          there and no service is running. A session that was open when the backup was taken arrives
          open with nothing armed, and the first app open repairs it like any session that lost its
          alarms (`SessionWatchdog.reviveIfNeeded`): the day boundary is derived from the row's own
          `date_key` in the zone `session_zone_prefs` recorded at check-in and, already past,
          closes the session at that midnight as `DAY_BOUNDARY`.

          There is deliberately no tracking-start entry here. The start is read from the sessions
          table itself (`CheckInRepository.trackingStartFlow`), so it cannot arrive without them.
        -->
        <exclude domain="sharedpref" path="checkin_timer_prefs.xml" />
        <!--
          `prompt_prefs` records that a one-time prompt has already been raised. Restored onto a new
          device it would assert that of prompts never shown there — and a cloud restore does not
          carry runtime permission grants, so `notifications_asked` would suppress the launch
          request on a device that has granted nothing, leaving the timer notification, the session
          reminder and every nudge silently dead. So a restored install sees the welcome tour once
          more; the naming step is read from the habits table, so restored habits skip it.
        -->
        <exclude domain="sharedpref" path="prompt_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!--
          Included by default, and correctly so: a direct device-to-device transfer moves the files
          and the permission grants together, so both the record and the prompts already answered
          land beside what they describe.
        -->
    </device-transfer>
</data-extraction-rules>
