<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The sessions DB never leaves the device via Google cloud backup. -->
        <exclude domain="database" path="_app" />
        <exclude domain="database" path="_app-shm" />
        <exclude domain="database" path="_app-wal" />
        <!--
          `checkin_timer_prefs` mirrors a live session for rendering, so it describes rows a cloud
          restore does not bring with it.

          There is deliberately no tracking-start entry here any more. It used to be a preference,
          and excluding it was how the app stopped a restore reporting every day since as one the
          user did not show up for. The start is now read from the sessions table itself
          (`CheckInRepository.trackingStartFlow`), so it cannot arrive without them and there is
          nothing left to exclude.
        -->
        <exclude domain="sharedpref" path="checkin_timer_prefs.xml" />
        <!--
          `prompt_prefs` records that a one-time prompt has already been raised. Restored onto a new
          device it would assert that of prompts never shown there — and a cloud restore does not
          carry runtime permission grants, so `notifications_asked` would suppress the launch
          request on a device that has granted nothing, leaving the timer notification, the session
          reminder and every nudge silently dead.
        -->
        <exclude domain="sharedpref" path="prompt_prefs.xml" />
        <!--
          `reminder_prefs` is deliberately not excluded: it holds the reminder hour the user chose,
          which is a preference rather than a record of something done on this device, so restoring
          it lands their own choice on the new one.
        -->
    </cloud-backup>
    <device-transfer>
        <!--
          Included by default, and correctly so: a direct device-to-device transfer moves the DB and
          the permission grants together, so both the record and the prompts already answered land
          beside what they describe.
        -->
    </device-transfer>
</data-extraction-rules>
