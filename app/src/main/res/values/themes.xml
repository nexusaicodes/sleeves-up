<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cold-start splash, on the app's own window background so the hand-over doesn't flash. -->
    <style name="Theme.CheckInApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <!-- Read by Android 12 only. -->
        <item name="windowSplashScreenAnimationDuration">680</item>
        <item name="postSplashScreenTheme">@style/Theme.CheckInApp</item>
    </style>

    <!-- Post-splash app theme. DayNight so the window background follows light/dark (no white
         flash before Compose draws); brand surface via @color/brand_window_background. Compose
         draws all chrome, so the platform action bar is disabled. -->
    <style name="Theme.CheckInApp" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/brand_window_background</item>
    </style>

    <!-- The home-screen widget's label, in both its static and cycling forms. The system's
         sans-serif rather than the bundled faces: a widget is drawn by the launcher, and a bundled
         font in a remote layout is not something every launcher honours. -->
    <style name="WidgetLabel">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <!-- Two lines: the name is what the widget says, and a verb that is longer in another
             language (Arabic's runs about twice the English) must wrap it, not ellipsize it. -->
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
