<?xml version="1.0" encoding="utf-8"?>
<!--
    Casing: section and card titles are Title Case ("The Numbers", "Days Split"), and so are
    notification channel names ("Check-In Timer", "Session Reminders"), which Android renders as the
    titles of one list; everything a user reads as a line rather than a heading — row labels,
    buttons, help text, empty states — is sentence case ("Grant access", "Showed up").
    The only exceptions are the product name Sleeves Up and the "Check In"/"Check Out" actions the
    app is built around.

    Nothing here grades a day. There is no target, no half day and no absence — a day is one the user
    showed up for or one they didn't, and the copy must not reintroduce a verdict.
-->
<resources>
    <!-- App Name. "Sleeves Up" is the product (matching the Play listing); "Check In" is the
         action, and the two are not interchangeable — see nav_check_in and check_in below. -->
    <string name="app_name" translatable="false">Sleeves Up</string>

    <!-- Navigation -->
    <string name="nav_check_in">Check In</string>
    <string name="nav_history">History</string>
    <string name="nav_reports">Reports</string>
    <string name="nav_settings">Settings</string>
    <string name="nav_licenses">Licences</string>
    <string name="nav_privacy">Privacy</string>

    <!-- Shared by every dialog's dismiss button. -->
    <string name="action_cancel">Cancel</string>

    <!-- Check-In Screen -->
    <string name="check_in">Check In</string>
    <string name="check_out">Check Out</string>
    <!-- The button names the habit it writes to: the switcher is the only other place that says. -->
    <string name="check_in_to">Check in to %1$s</string>
    <string name="check_out_of">Check out of %1$s</string>
    <string name="todays_sessions_summary">%1$s · %2$s today</string>
    <string name="session_in_progress">ongoing</string>
    <!-- A settled session row, spoken as one phrase: its clock range, then its duration. -->
    <string name="cd_session_row">%1$s, %2$s</string>
    <!-- A session's start and end, each a clock time or "ongoing". -->
    <string name="session_range">%1$s - %2$s</string>
    <plurals name="sessions_count">
        <item quantity="one">%d session</item>
        <item quantity="other">%d sessions</item>
    </plurals>
    <!--
      The check-out celebration. Worded for showing up rather than for how long: this copy is shown
      unchanged after a 20-minute session and after a nine-hour one, and warming it as the number
      grows would make it a verdict on the hours.
    -->
    <string name="checkout_celebration_title">You showed up</string>
    <string name="checkout_celebration_dismiss">Tap to close</string>

    <!-- Presence check. No image is captured, so nothing here may say "photo", "capture" or
         "selfie" — the camera reports whether a face is in frame and the app reads only that. -->
    <string name="presence_dismiss">Dismiss</string>
    <string name="presence_face_detected">You\'re here!</string>
    <!-- The whole of what the screen says while it looks. There is nothing to confirm: the check
         passes itself on the frame the camera finds a face in, so this states what is happening
         rather than asking for anything. -->
    <string name="presence_looking">Looking for a face…</string>
    <!-- Replaces the line above once the wait for a face runs out and the device-unlock button
         appears. It is what tells the user why: a control arriving in silence beneath text still
         saying the camera is working on it explains nothing, and this line is inside the live region,
         so it is also the only announcement a screen reader gets that anything changed. -->
    <string name="presence_looking_slow">Still looking. You can use device unlock instead.</string>
    <!-- Shown when the camera reports no face-detection mode: it will never find anyone, so device
         unlock is offered straight away rather than after the usual wait. -->
    <string name="presence_unsupported">This camera can\'t check for a face. Use device unlock instead.</string>
    <!-- Same state, but the device has no screen lock, so the fallback the line above names does not
         exist yet. Both the message and the button point at the settings screen that creates one. -->
    <string name="presence_unsupported_no_unlock">This camera can\'t check for a face. Set up a screen lock to use device unlock instead.</string>
    <string name="presence_set_up_screen_lock">Set up screen lock</string>

    <!-- Biometric fallback. One gate serves check-in, check-out and re-auth, so the subtitle names
         the presence check rather than any one of them. -->
    <string name="biometric_title">Verify it\'s you</string>
    <string name="biometric_subtitle">Use your device unlock to verify your presence</string>
    <string name="biometric_use_device_unlock">Use device unlock</string>
    <string name="biometric_unavailable">Device unlock isn\'t available</string>

    <!-- Open-session reminder. It only asks: ignoring it costs nothing, and the copy must not imply
         otherwise. The session ends on its own at midnight, which is worth saying here because it is
         the one thing that happens without the user doing anything. -->
    <string name="reminder_channel_name">Session Reminders</string>
    <string name="reminder_channel_description">Reminds you that a session is still running</string>
    <string name="reminder_title">Still checked in?</string>
    <string name="reminder_text">Your session is still running. It closes on its own at midnight.</string>

    <!-- Check-in reminders, one channel per habit, in one group. Each habit's channel is the only
         opt-out there is for that habit's reminder — there is no in-app switch — so the name has to
         be the words a user hunting for one would look for, and the description has to say what
         turning it off actually stops. "Nudge" is internal vocabulary and stays out of all of them.
         A channel's name and description are updatable after creation; its id and importance are
         not. "Session Reminders" sits near these, so the descriptions carry the difference: muting
         the wrong one costs the prompt that catches a forgotten open session. "Once a day at most"
         is one nudge per habit per day, not a round number chosen to sound sparing: if that rule
         changes, these lines are wrong. nudge_channel_* name the seed habit's channel until the
         habit has a name of its own. -->
    <string name="habit_channel_group_name">Habit Reminders</string>
    <string name="habit_channel_name">%1$s Reminders</string>
    <string name="habit_channel_description">Reminds you to check in to %1$s on days you haven\'t yet. Once a day at most.</string>
    <string name="nudge_channel_name">Check-In Reminders</string>
    <string name="nudge_channel_description">Reminds you to check in on days you haven\'t yet. Once a day at most.</string>

    <!-- One wording, no variants: nothing in the app can tell two arms apart, so a second one is only
         a second string to keep in step. The title names the habit, because a reminder that does
         not say which habit it is about is one a user with two cannot act on; the unnamed title is
         for a habit still owed a name. Copy never warms or grows urgent — that would invent a
         deadline this app does not have, and grade a day that is not over. Time-neutral, because the
         user picks the time. No notification names the time: delivery is best-effort, so a stated
         time is a punctuality promise the app cannot keep. -->
    <string name="nudge_not_checked_in_title">%1$s: no session yet today</string>
    <string name="nudge_not_checked_in_unnamed_title">No session yet today</string>
    <string name="nudge_not_checked_in_body">Whenever you start, it counts — a short day is still a day shown up for.</string>

    <!--
      The first-run welcome tour, shown once before anything is asked for. The order is the point:
      the naming step follows the last page, and the notification permission dialog follows that,
      so a reminder time has just been picked when reminders are requested.

      Sentence case — these read as lines, not card titles. Nothing grades a day, by the same rules
      the nudge copy follows.
    -->
    <!-- The quote is Will Durant's summary of Aristotle, not Aristotle's words; the attribution says so. -->
    <string name="welcome_quote_title">Make it a habit</string>
    <string name="welcome_quote_body">“We are what we repeatedly do. Excellence, then, is not an act, but a habit.” — Will Durant, on Aristotle</string>
    <!--
      The app's thesis. "A glance at the camera", never "scan": this is face detection, not
      recognition, and no copy may read as matching the user against an enrolled identity.
    -->
    <string name="welcome_showing_up_title">Showing up is what counts</string>
    <string name="welcome_showing_up_body">Check in with a glance at the camera, and check out the same way. Your time is logged, but showing up is what counts.</string>
    <!-- The last page leads into the naming step, where the first habit's reminder time is picked
         immediately before the notification dialog. "Habit", never "goal": a goal is a target, and this app
         has none. -->
    <string name="welcome_habits_title">One habit at a time</string>
    <string name="welcome_habits_body">Start with one habit you want to build, and add more later — each keeps its own record.</string>
    <string name="welcome_widget_title">On your home screen</string>
    <string name="welcome_widget_body">Add the widget to check in or out without opening the app first. The same presence check runs.</string>
    <string name="welcome_widget_add">Add widget</string>
    <string name="welcome_widget_manual">Touch and hold an empty part of your home screen, then choose Widgets.</string>
    <string name="widget_page_done">Done</string>
    <!-- Spoken by the dot row. HorizontalPager publishes a scroll range and no page count, so
         without this a screen reader is never told where in the tour it is. -->
    <string name="welcome_page_position">Page %1$d of %2$d</string>
    <string name="welcome_skip">Skip</string>
    <string name="welcome_next">Next</string>
    <string name="welcome_start">Get started</string>

    <!-- Empty / first-run states -->
    <string name="empty_checkin_title">Ready when you are</string>
    <string name="empty_day_detail_title">No day selected</string>
    <string name="empty_day_detail_message">Tap a day in the calendar to see its sessions.</string>

    <!-- Accessibility -->
    <string name="cd_day_worked">%1$d, %2$s worked</string>
    <string name="cd_expand_sessions">Show today\'s sessions</string>
    <string name="cd_collapse_sessions">Hide today\'s sessions</string>
    <string name="cd_days_split">Days split: %1$s showed up, %2$s missed</string>
    <!-- Three counts, so none can be a plural's own quantity: each is worded through a plural first
         and arrives here as a phrase. -->
    <string name="cd_start_time_split">Start times: %1$s in the morning, %2$s in the afternoon, %3$s in the evening</string>
    <string name="cd_sessions_per_day_split">Sessions per day: %1$s with one session, %2$s with two, %3$s with three or more. Average %4$s.</string>
    <!-- The gauge is the open session, never the day's total (see TimerGauge), so this must name the
         session rather than the day. Its ring sweeps hourly and means nothing as a fraction, so this
         states the time and only the time — a sweep position read as progress would invent a goal. -->
    <string name="cd_timer_gauge">%1$s this session</string>

    <!-- History Screen -->
    <string name="previous_month">Previous month</string>
    <string name="next_month">Next month</string>
    <!-- The day the user tapped, and what it held: a count and the sum of the rows printed
         directly beneath it. History states what was recorded and derives nothing — the averages
         and ratios that used to sit here live on Reports. -->
    <string name="day_sessions_summary">%1$s · %2$s</string>
    <!-- A tracked day with nothing on it, and a day that has not happened yet. States the absence
         without judging it, in the same register as the calendar's untinted cell. -->
    <string name="empty_day_sessions_message">No sessions recorded on this day.</string>

    <!-- Reports Screen -->
    <!-- The scope selector's end-stop, read as a standalone label. -->
    <string name="scope_all_time">All time</string>
    <!-- The same scope read inside a sentence ("Export all time"), where the Title Case form lands a
         capital mid-clause. A month name needs no such pair — it is a proper noun either way. -->
    <string name="scope_all_time_inline">all time</string>
    <!-- A scope covering no counted day: a month outside the record, or a record whose only day is
         a today still in progress. States the absence without rendering it as a row of zeros, which
         would assert the user showed up on none of some number of days. -->
    <string name="empty_scope_title">Nothing recorded here</string>
    <string name="empty_scope_message">No completed day in %1$s. Use the arrows to look at another month.</string>
    <!-- The all-time counterpart. The month arrows are disabled under this scope, so pointing at
         them would name a control the user cannot press. -->
    <string name="empty_scope_message_all_time">No day has been checked out of yet. Check out of a session and it appears here.</string>
    <string name="scope_stats_title">The Numbers</string>
    <string name="stat_showed_up">Showed up</string>
    <string name="stat_missed">Missed</string>
    <string name="stat_tracking_since">Tracking since</string>
    <!-- Every day in the scope, including days with no sessions — not "days I recorded". -->
    <string name="stat_tracked_days">Days tracked</string>
    <!-- Totals and averages, stated and left alone. Nothing is measured against any of them, and
         none of them may grow a ring: the only denominator available is the user's own all-time
         equivalent, which is a personal best under another name. -->
    <string name="stat_total_hours">Total hours</string>
    <string name="stat_total_sessions">Total sessions</string>
    <string name="stat_avg_per_day">Hours per tracked day</string>
    <string name="stat_sessions_per_day">Sessions per day showed up</string>
    <string name="chart_daily_hours_title">Daily Hours</string>
    <!-- The dashed line is the window's own mean, not a target — nothing here is a bar to clear. -->
    <plurals name="chart_daily_hours_subtitle">
        <item quantity="one">%1$d day · dashed line = average</item>
        <item quantity="other">%1$d days · dashed line = average</item>
    </plurals>
    <!-- Scope-neutral on purpose: the card was "All-Time Split" and said so while rendering a
         single month's figures the moment Reports gained a scope. No title here may name a span —
         the selector above states which one is active. -->
    <string name="chart_split_title">Days Split</string>
    <string name="chart_monthly_title">Hours by Month</string>
    <!-- States the window and nothing else. No superlative: naming the window's longest day ranks
         one of the user's days against the others, which nothing in the app does. -->
    <plurals name="cd_daily_hours_chart">
        <item quantity="one">Daily hours over %1$d day.</item>
        <item quantity="other">Daily hours over %1$d days.</item>
    </plurals>
    <string name="cd_monthly_chart">Hours by month: %1$s</string>
    <!-- One month in the monthly chart's spoken list: the month, then its hours. -->
    <string name="cd_monthly_chart_entry">%1$s %2$s</string>
    <!-- Joins the entries of a spoken list. Quoted to keep its trailing space. -->
    <string name="list_separator">", "</string>
    <!-- The two descriptive splits. Neither ranks its slices: there is no better hour to start at
         and no right number of blocks to break a day into, and any copy implying one would be the
         deleted daily target applied to the shape of a day instead of its length. -->
    <string name="chart_start_times_title">Start Times</string>
    <string name="chart_sessions_per_day_title">Sessions Per Day</string>
    <string name="bucket_morning">Morning</string>
    <string name="bucket_afternoon">Afternoon</string>
    <string name="bucket_evening">Evening</string>
    <string name="band_three_plus">3 or more</string>
    <plurals name="days_count">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <string name="export_title">Export Data</string>
    <!-- One button following the scope selector: a second way to choose a range is a control that
         can disagree with the screen above it. -->
    <string name="export_scope">Export %1$s</string>
    <string name="export_chooser_title">Export Sessions</string>
    <!-- Posted once the file exists and the share sheet is up; the user has not picked a target yet. -->
    <string name="export_success">CSV ready to share</string>
    <string name="export_nothing">No completed days to export yet</string>
    <string name="export_failed">Export failed: %1$s</string>

    <!--
