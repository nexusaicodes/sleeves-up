    -->
    <string name="reminder_time_value">Around %1$s</string>
    <!-- A time button's click action, spoken by TalkBack after the summary it shows. -->
    <string name="reminder_time_change">Change reminder time</string>
    <string name="reminder_time_dialog_title">Reminder Time</string>
    <string name="reminder_time_confirm">Set</string>
    <!-- Under the clock: the range a reminder may be set in, turning to the error colour outside it. -->
    <string name="reminder_time_range">Between %1$s and %2$s</string>

