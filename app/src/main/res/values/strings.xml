<?xml version="1.0" encoding="utf-8"?>
<!--
    Casing: section and card titles are Title Case ("Overall Stats", "All-Time Split"), and so are
    notification channel names ("Check-In Timer", "Session Reminders"), which Android renders as the
    titles of one list; everything a user reads as a line rather than a heading — row labels,
    buttons, help text, empty states — is sentence case ("Grant access", "Showed up").
    The only exceptions are the product name CheckIn and the "Check In"/"Check Out" actions it is
    named after.

    Nothing here grades a day. There is no target, no half day and no absence — a day is one the user
    showed up for or one they didn't, and the copy must not reintroduce a verdict.
-->
<resources>
    <!-- App Name. "CheckIn" is the product (matching the Play listing); "Check In" with a space is
         the action, and the two are not interchangeable — see nav_check_in and check_in below. -->
    <string name="app_name">CheckIn</string>

    <!-- Navigation -->
    <string name="nav_check_in">Check In</string>
    <string name="nav_history">History</string>
    <string name="nav_reports">Reports</string>
    <string name="nav_settings">Settings</string>
    <string name="nav_licenses">Open Source</string>

    <!-- Check-In Screen -->
    <string name="check_in">Check In</string>
    <string name="check_out">Check Out</string>
    <string name="todays_sessions_summary">%1$s · %2$s today</string>
    <string name="session_in_progress">ongoing</string>
    <!-- A settled session row, spoken as one phrase: its clock range, then its duration. -->
    <string name="cd_session_row">%1$s, %2$s</string>
    <plurals name="sessions_count">
        <item quantity="one">%d session</item>
        <item quantity="other">%d sessions</item>
    </plurals>
    <!--
      The check-out celebration. Worded for showing up rather than for how long: this copy is shown
      unchanged after a 20-minute session and after a nine-hour one, and warming it as the number
      grows would make it a verdict on the hours.
    -->
    <string name="checkout_celebration_title">You showed up</string>
    <string name="checkout_celebration_dismiss">Tap to close</string>

    <!-- Presence check. No image is captured, so nothing here may say "photo", "capture" or
         "selfie" — the camera reports whether a face is in frame and the app reads only that. -->
    <string name="presence_dismiss">Dismiss</string>
    <string name="presence_face_detected">You\'re here!</string>
    <!-- The whole of what the screen says while it looks. There is nothing to confirm: the check
         passes itself on the frame the camera finds a face in, so this states what is happening
         rather than asking for anything. -->
    <string name="presence_looking">Looking for a face…</string>
    <!-- Shown when the camera reports no face-detection mode: it will never find anyone, so device
         unlock is offered straight away rather than after the usual wait. -->
    <string name="presence_unsupported">This camera can\'t check for a face. Use device unlock instead.</string>
    <!-- Same state, but the device has no screen lock, so the fallback the line above names does not
         exist yet. Both the message and the button point at the settings screen that creates one. -->
    <string name="presence_unsupported_no_unlock">This camera can\'t check for a face. Set up a screen lock to use device unlock instead.</string>
    <string name="presence_set_up_screen_lock">Set up screen lock</string>

    <!-- Biometric fallback. One gate serves check-in, check-out and re-auth, so the subtitle names
         the presence check rather than any one of them. -->
    <string name="biometric_title">Verify it\'s you</string>
    <string name="biometric_subtitle">Use your device unlock to verify your presence</string>
    <string name="biometric_use_device_unlock">Use device unlock</string>
    <string name="biometric_unavailable">Device unlock isn\'t available</string>

    <!-- Open-session reminder. It only asks: ignoring it costs nothing, and the copy must not imply
         otherwise. The session ends on its own at midnight, which is worth saying here because it is
         the one thing that happens without the user doing anything. -->
    <string name="reminder_channel_name">Session Reminders</string>
    <string name="reminder_channel_description">Reminds you that a session is still running</string>
    <string name="reminder_title">Still checked in?</string>
    <string name="reminder_text">Your session is still running. It closes on its own at midnight.</string>

    <!-- Engagement nudges. This channel is the only opt-out there is — there is no in-app switch — so
         the name has to be the words a user hunting for one would look for, and the description has
         to say what turning it off actually stops. "Nudge" is internal vocabulary and stays out of
         both. A channel's name and description are updatable after creation; its id and importance
         are not. The name is near-synonymous with "Session Reminders" one row away, so the two
         descriptions carry the difference: muting the wrong one costs the prompt that catches a
         forgotten open session. -->
    <string name="engagement_channel_name">Check-In Reminders</string>
    <string name="engagement_channel_description">Occasional reminders when you haven\'t checked in. At most two a day.</string>

    <!-- One pair per checkpoint, because a second send in a day arriving as the same string reads as
         a stuck loop rather than as a message that came back. Two variants each, A/B, and variant B
         is a second *wording*, never a warmer or more urgent one — escalating across the day would
         invent a deadline this app does not have, and would grade a day that is not over. No copy
         names the hour: delivery is best-effort, so a stated time is a punctuality promise the app
         cannot keep. -->
    <string name="nudge_not_checked_in_morning_title_a">Ready when you are</string>
    <string name="nudge_not_checked_in_morning_body_a">You haven\'t checked in yet today. Tap to start your session.</string>
    <string name="nudge_not_checked_in_morning_title_b">Start the clock?</string>
    <string name="nudge_not_checked_in_morning_body_b">Your day hasn\'t started in CheckIn yet. Tap to check in now.</string>
    <string name="nudge_not_checked_in_afternoon_title_a">No session yet today</string>
    <string name="nudge_not_checked_in_afternoon_body_a">Whenever you start, it counts — a short day is still a day shown up for.</string>
    <string name="nudge_not_checked_in_afternoon_title_b">Nothing recorded today</string>
    <string name="nudge_not_checked_in_afternoon_body_b">There\'s no session on today yet. Tap whenever you\'re ready to start one.</string>
    <string name="nudge_not_checked_in_evening_title_a">Still time today</string>
    <string name="nudge_not_checked_in_evening_body_a">Today\'s record closes at midnight. Tap to check in.</string>
    <string name="nudge_not_checked_in_evening_title_b">The day\'s not over</string>
    <string name="nudge_not_checked_in_evening_body_b">A short session lands on your calendar the same as a long one. Tap to start.</string>

    <!--
      The first-run welcome tour, shown once before anything is asked for. The order is the point:
      the notification permission dialog opens the moment the last page is finished, so the
      reminders are described immediately before they are requested.

      Sentence case — these read as lines, not card titles. Nothing grades a day or names an hour,
      by the same rules the nudge copy follows. "Twice a day" is NudgeConfig.maxPerDay, not a round
      number chosen to sound generous: if that value changes, this line is wrong.
    -->
    <string name="welcome_showing_up_title">Showing up is the whole thing</string>
    <string name="welcome_showing_up_body">Check in when you start, check out when you stop. There\'s no target to clear — a short day counts the same as a long one.</string>
    <!--
      The disclosure's own clauses rather than a paraphrase, so the two cannot drift apart about the
      same camera. "Confirms someone\'s there" is load-bearing: this is face detection, not
      recognition, and no copy may read as matching the user against an enrolled identity.
    -->
    <string name="welcome_presence_title">Presence, checked on this device</string>
    <string name="welcome_presence_body">The front camera confirms someone\'s there at check-in and check-out. No photo is taken and no image ever leaves the camera.</string>
    <string name="welcome_reminders_title">A reminder if the day gets away</string>
    <string name="welcome_reminders_body">If you haven\'t checked in, CheckIn says so — at most twice a day. Turn them off with a long press on any reminder.</string>
    <!-- Spoken by the dot row. HorizontalPager publishes a scroll range and no page count, so
         without this a screen reader is never told where in the tour it is. -->
    <string name="welcome_page_position">Page %1$d of %2$d</string>
    <string name="welcome_skip">Skip</string>
    <string name="welcome_next">Next</string>
    <string name="welcome_start">Get started</string>

    <!-- Empty / first-run states -->
    <string name="empty_checkin_title">Ready when you are</string>
    <string name="empty_reports_title">No completed days yet</string>
    <string name="empty_reports_message">Your charts, streaks, and totals appear here once your first tracked day is over.</string>
    <string name="empty_day_detail_title">No day selected</string>
    <string name="empty_day_detail_message">Tap a day in the calendar to see its sessions.</string>

    <!-- Accessibility -->
    <string name="cd_day_worked">%1$d, %2$s worked</string>
    <string name="cd_expand_sessions">Show today\'s sessions</string>
    <string name="cd_collapse_sessions">Hide today\'s sessions</string>
    <string name="cd_month_split">Month split: %1$s showed up, %2$s missed</string>
    <!-- A ring's fill is a ratio and colour carries none of it, so each tile states both figures. -->
    <string name="cd_stat_vs_all_time">%1$s this month: %2$s, against %3$s all time</string>
    <string name="cd_alltime_split">All-time split: %1$s showed up, %2$s missed</string>
    <!-- The gauge is the open session, never the day's total (see TimerGauge), so this must name the
         session rather than the day. Its ring sweeps hourly and means nothing as a fraction, so this
         states the time and only the time — a sweep position read as progress would invent a goal. -->
    <string name="cd_timer_gauge">%1$s this session</string>

    <!-- History Screen -->
    <string name="previous_month">Previous month</string>
    <string name="next_month">Next month</string>
    <string name="day_detail_title">Sessions on %1$s</string>
    <string name="stat_showed_up">Showed up</string>
    <string name="stat_missed">Missed</string>
    <string name="stat_days_label">days tracked</string>
    <string name="stat_avg_per_day">Avg / day</string>
    <string name="stat_longest_day">Longest day</string>
    <!-- Each summary ring is filled against the user's own record, so every tile names that
         baseline underneath. Never a target: this app has none, and a ring measured against one
         would be that target under another name. -->
    <plurals name="stat_baseline_of_days">
        <item quantity="one">of %1$d day</item>
        <item quantity="other">of %1$d days</item>
    </plurals>
    <string name="stat_baseline_all_time">all time %1$s</string>

    <!-- Reports Screen -->
    <string name="overall_stats_title">Overall Stats</string>
    <string name="stat_tracking_since">Tracking since</string>
    <!-- Every day in the window, including days with no sessions — not "days I recorded". -->
    <string name="stat_total_tracked_days">Days since tracking started</string>
    <!-- Streaks count consecutive days with any session: showing up is the unit, not the hours. -->
    <string name="stat_current_streak">Current streak</string>
    <string name="stat_best_streak">Best streak</string>
    <string name="chart_daily_hours_title">Daily Hours</string>
    <!-- The dashed line is the window's own mean, not a target — nothing here is a bar to clear. -->
    <plurals name="chart_daily_hours_subtitle">
        <item quantity="one">Last %1$d day · dashed line = average</item>
        <item quantity="other">Last %1$d days · dashed line = average</item>
    </plurals>
    <string name="chart_split_title">All-Time Split</string>
    <string name="chart_monthly_title">Hours by Month</string>
    <plurals name="cd_daily_hours_chart">
        <item quantity="one">Daily hours over the last %1$d day. Best day %2$s.</item>
        <item quantity="other">Daily hours over the last %1$d days. Best day %2$s.</item>
    </plurals>
    <string name="cd_monthly_chart">Hours by month: %1$s</string>
    <plurals name="days_count">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <string name="export_title">Export Data</string>
    <string name="export_this_month">This month</string>
    <string name="export_all_time">All time</string>
    <string name="export_chooser_title">Export Sessions</string>
    <!-- Posted once the file exists and the share sheet is up; the user has not picked a target yet. -->
    <string name="export_success">CSV ready to share</string>
    <string name="export_nothing">No completed days to export yet</string>
    <string name="export_failed">Export failed: %1$s</string>

    <!-- About. Settings holds nothing else — see SettingsScreen for why. -->
    <string name="about_section">About</string>
    <string name="about_version">Version %1$s (build %2$d)</string>
    <string name="about_developer">Nexus AI Technology Labs</string>
    <string name="about_privacy_policy">Privacy policy</string>
    <string name="about_feedback">Send feedback</string>
    <string name="about_rate">Rate on Google Play</string>
    <string name="about_licenses">Open source licenses</string>
    <string name="about_open_link">Opens outside the app</string>
    <string name="about_no_email_app">No email app found. Address copied: %1$s</string>
    <string name="about_no_browser">No browser found. Link copied to the clipboard.</string>
    <string name="about_no_handler">Nothing on this device can open that.</string>

    <!-- Open source licenses -->
    <string name="licenses_intro">CheckIn is built on these projects. Grouped by upstream project rather than by artifact.</string>
    <!-- Named after the licence it opens: these buttons sit below every library card, far from any
         context. The text is bundled rather than linked because Apache-2.0 section 4(a) and the OFL
         both oblige the app to ship a copy, and an offline device could not fetch one. -->
    <string name="licenses_show_full_text">Show %1$s text</string>
    <string name="licenses_hide_full_text">Hide %1$s text</string>
    <string name="nav_back">Back</string>

    <!-- Notification (Foreground Service) -->
    <string name="notification_channel_name">Check-In Timer</string>
    <string name="notification_channel_description">Shows the active check-in timer</string>
    <string name="notification_title">Checked In</string>
    <!-- The elapsed time is drawn by the platform's own chronometer in the timestamp slot, so the
         body must not print it too — it would appear twice, and the copy would be the stale one. -->
    <string name="notification_running">Timing your session</string>
    <string name="notification_action_stop">Check Out</string>

    <!-- Camera prominent disclosure, shown before the camera permission request at the first
         check-in. The camera runs face *detection* — it looks for any face, it does not match one
         against an enrolled identity, so none of this may read as "selfie verification". -->
    <string name="camera_disclosure_title">Presence verification</string>
    <!-- Detection is done by the camera hardware and reaches the app as a face count, so no frame is
         ever written, read or held. "No photo is taken" is the literal truth here, and it replaced
         "then deleted" — which was the honest claim only while a JPEG briefly existed. -->
    <string name="camera_disclosure_message">Your front camera checks that someone is there at check-in and check-out. No photo is taken and no image ever leaves the camera.</string>
    <string name="camera_disclosure_button">Continue</string>

    <!-- Recovery screen, shown only after the camera permission is refused -->
    <string name="camera_permission_title">Camera access needed</string>
    <string name="camera_permission_message">Check-in and check-out verify your presence with the front camera, so neither can run without it.</string>
    <string name="camera_permission_button">Grant access</string>
    <string name="presence_gate_cancel">Not now</string>
</resources>
