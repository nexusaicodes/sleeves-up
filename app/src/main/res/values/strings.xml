    <string name="notification_channel_description">Shows the active check-in timer</string>
    <string name="notification_title">Checked In</string>
    <string name="notification_title_habit">Checked In: %1$s</string>
    <!-- The elapsed time is drawn by the platform's own chronometer in the timestamp slot, so the
         body must not print it too — it would appear twice, and the copy would be the stale one. -->
    <string name="notification_running">Timing your session</string>
    <string name="notification_action_stop">Check Out</string>

    <!-- Camera prominent disclosure, shown before the camera permission request at the first
         check-in. The camera runs face *detection* — it looks for any face, it does not match one
         against an enrolled identity, so none of this may read as "selfie verification". -->
    <string name="camera_disclosure_title">Presence check</string>
    <!-- What happens and when, nothing more. Detection is done by the camera hardware and reaches
         the app as a face count, so if this ever says anything about images it may only say none is
         taken — never photo, capture or selfie as something that happens. -->
    <string name="camera_disclosure_message">The front camera checks you\'re here when you check in or out.</string>
    <string name="camera_disclosure_button">Continue</string>

    <!-- Recovery screen, shown only after the camera permission is refused -->
    <string name="camera_permission_title">Camera access needed</string>
    <string name="camera_permission_message">Check-in and check-out verify your presence with the front camera, so neither can run without it.</string>
    <string name="camera_permission_button">Grant access</string>
    <string name="presence_gate_cancel">Not now</string>

    <!--
      Time and date formats. These are patterns, not prose: each language sets its own unit letters
      and field order. The duration templates take two whole numbers (%1$d then %2$d); the date
      patterns are java.time DateTimeFormatter patterns (d day, EEEE weekday, MMM/MMMM month, yy/yyyy
      year, hh/h hour, mm minute, a am/pm; text in single quotes is literal, and \'\' is one
      apostrophe). Digits are always Latin. Translate the order and the punctuation, never the letters
      of a pattern.
    -->
    <string name="time_hours_minutes">%1$dh %2$dm</string>
    <string name="time_minutes_seconds">%1$dm %2$ds</string>
    <string name="time_clock_pattern">hh:mm a</string>
    <string name="date_with_year_pattern">d MMM yyyy</string>
    <string name="date_with_weekday_pattern">EEEE d MMM</string>
    <string name="date_axis_day_pattern">d MMM</string>
    <string name="date_axis_month_year_pattern">MMM \'\'yy</string>
    <string name="date_axis_month_pattern">MMM</string>
    <string name="date_month_year_pattern">MMMM yyyy</string>
    <!-- The language this file is written in, as an ISO 639 code. The app reads it to know which
         language Android resolved, so it must name this file's language and nothing else. -->
    <string name="language_code">en</string>
</resources>
