<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated Info.plist: the keys that take arrays, which build settings cannot set. -->
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nexusai.checkin.app.refresh</string>
	</array>
	<!-- The Live Activity's Check Out link. Whoever opens it gets only the presence gate, which
	     writes nothing unless someone present passes it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nexusai.checkin.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sleevesup</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
