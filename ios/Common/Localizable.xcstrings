    "ongoing" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارية"
          }
        }
      }
    },
    "the running habit" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العادة الجارية"
          }
        }
      }
    },
    "“We are what we repeatedly do. Excellence, then, is not an act, but a habit.” — Will Durant, on Aristotle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«نحن ما نفعله مرارًا وتكرارًا. فالتميّز إذن ليس فعلًا، بل عادة.» — ويل ديورانت، عن أرسطو"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
