root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# `intellij_idea` matches `kotlin.code.style=official` in gradle.properties — the style the
# codebase was written in. `ktlint_official` is a stricter, differently-opinionated style and
# switching to it would rewrite most files.
ktlint_code_style = intellij_idea
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Composables are PascalCase by convention (see CLAUDE.md); ktlint's camelCase function rule
# has no built-in exemption for them, so it is named here explicitly.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json}]
indent_size = 2

[*.{xml,pro}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

